NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when the deployment proxy safely overwrites forwarded client IP headers.
TRUST_PROXY=false
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mandamoney_test
# Random secret of at least 32 characters. Required for CSV import and legacy
# phone-and-birthday login; birthdays are never stored in MongoDB.
LEGACY_AUTH_PEPPER=
# Server-side Gemini API key for receipt-photo product extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LOG_LEVEL=info
