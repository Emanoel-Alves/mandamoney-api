NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when the deployment proxy safely overwrites forwarded client IP headers.
TRUST_PROXY=false
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mandamoney_test
# Random secret of at least 32 characters. Required for CSV import and legacy
# phone-and-birthday login; birthdays are never stored in MongoDB.
LEGACY_AUTH_PEPPER=
# Apps Script /exec endpoint used for NFC-e QR parsing during transition.
NFCE_PROVIDER_URL=
# Current OCR service endpoint; keep its deployment secret and URL on the API.
OCR_PROVIDER_URL=https://mandamoney-ocr.onrender.com/ocr
LOG_LEVEL=info
