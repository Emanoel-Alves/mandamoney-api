{
  "name": "mandamoney-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:atlas": "tsx --test src/atlas.integration.ts",
    "import:legacy": "tsx src/import-legacy.ts",
    "seed:test": "tsx src/seed-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" package.json tsconfig.json openapi.yaml render.yaml README.md",
    "format:check": "prettier --check \"src/**/*.ts\" package.json tsconfig.json openapi.yaml render.yaml README.md"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mongodb": "^6.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0"
  }
}
